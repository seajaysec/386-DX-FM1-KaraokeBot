# a new song from SAVE's list (LOAD on an empty slot, S2) opens ready to write: the Voice's first phrase, the keys
# writing at the cursor; its words typed, sung back; then the song's phrases (HOME + SEQ): added, duped, moved,
# buffed out and in, resized and deleted
tap SAVE
tap SEL
turn SELECT 1
tap SEL
expect page Phrase
expect track Voice
expect slot 1
expect rows 0
expect phrases Voice 1
expect phrase_len Voice 0 4
# a key tapped: a sixteenth at the cursor, which moves on; held while SELECT turns, the note stretches with it
key 7
key 9
keydown 11
turn SELECT 2
keyup 11
key 12
keydown 14
turn SELECT 3
keyup 14
expect rows 1
expect notes 5
shot 01-voice-cursor
# the keys light with the notes at the cursor: steady where one starts, blinking inside one
turn SELECT -10
expect key_led 7 1
turn SELECT 3
expect key_blinks 11
# its words: SEL, EDIT WORDS
tap SEL
tap SEL
type hello robot friend
shot 02-words
tap SEL
expect line_text 0 hello robot friend
expect msg KEPT
# the knobs work on the note at the cursor: NOTE, NUDGE
turn SELECT -3
turn K3 2
turn K4 -1
expect pitch 0 0 62
expect nudge Voice 1 -1
# a tap on the note at the cursor takes it away; another writes one again
key 9
expect notes 4
key 7
expect notes 5
tap PLAY
wait 3500
expect sung 1
tap PLAY
shot 03-phrase
# HOME + SEQ: the words, and again: the song. ADD a phrase after this one, the cursor on it
down HOME
tap SEQ
up HOME
down HOME
tap SEQ
up HOME
expect page Song
tap SEL
tap SEL
expect msg ADDED
expect phrases Voice 2
# DUPE the first (its row sung again, the same line)
turn SELECT -1
tap SEL
turn SELECT 2
tap SEL
expect msg DUPED
expect phrases Voice 3
expect rows 2
shot 04-arrange
# MOVE: the dupe carried past the empty phrase, dropped with SEL
tap SEL
turn SELECT 4
tap SEL
turn SELECT 1
shot 05-moving
tap SEL
expect msg MOVED
# Drums: BUFF OUT the beat, BUFF IN a copy after it, LENGTH makes the copy four bars
turn ALGO 3
expect track Drums
tap SEL
turn SELECT 6
tap SEL
expect msg BUFFED OUT
tap SEL
turn SELECT 7
tap SEL
expect msg BUFFED IN
expect phrases Drums 2
turn K4 3
expect phrase_len Drums 1 4
# DELETE it again, after a question
tap SEL
turn SELECT 3
tap SEL
tap SEL
expect msg DELETED
expect phrases Drums 1
# the new song has lived in S2 since it began (S1 holds Greensleeves): SAVE held saves it there
expect slot 1
down SAVE 1500
up SAVE
expect saved 1
expect msg SAVED
