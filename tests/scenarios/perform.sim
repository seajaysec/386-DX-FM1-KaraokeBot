# steps, the cursor, punch-in, mutes, undo, tempo, help cards, the arpeggiator, saving and loading
# on a new song (4/4, 100 BPM): SAVE's list, LOAD, an empty slot
tap SAVE
tap SEL
turn SELECT 1
tap SEL
expect rows 0
expect page Phrase
turn ALGO 3
expect track Drums
# black key 3 (low tom... lane 2): white keys toggle its steps
key 6
key 0
key 4
key 9
shot 01-drum-steps
tap PLAY
wait 2500
tap PLAY
# keys: the keys write at the cursor, a chord when keys go down together; the cursor moves on a step
turn ALGO -2
expect track Keys
keydown 7
keydown 11
keydown 14
keyup 7
keyup 11
keyup 14
expect step Keys 1 60
key 9
expect step Keys 2 62
# a key held and SELECT turned: its note stretches with the cursor
keydown 12
turn SELECT 3
keyup 12
expect step Keys 3 65
shot 02-keys-cursor
# the knobs work on the note under the cursor: its NOTE, its NUDGE
turn SELECT -4
turn K3 2
expect step Keys 3 67
turn K4 2
expect nudge Keys 3 2
# a tap on a note at the cursor takes it away (the chord keeps the rest)
turn SELECT -2
key 7
expect step Keys 1 67
# undo it, redo it
down HOME
tap REC
up HOME
expect msg UNDO
expect step Keys 1 60
down HOME
tap PLAY
up HOME
expect msg REDO
expect step Keys 1 67
# tempo with HOME held and SELECT
down HOME
turn SELECT 8
up HOME
expect bpm 108
# HOME + SEQ: the song, its phrases; and again: back into the phrase
down HOME
tap SEQ
up HOME
expect page Song
down HOME
tap SEQ
up HOME
expect page Phrase
# Arp (ARP): Keys play the keys held one at a time, up, an eighth each
tap ARP
expect page Arp
turn K1 1
turn K2 1
shot 04-arp
keydown 7
keydown 11
keydown 14
wait 1500
keyup 7
keyup 11
keyup 14
turn K1 -1
turn ALGO 2
expect track Drums
# the drums' envelope: FUNK pushes the hits late
tap ENV
expect page Envelope
turn K1 20
shot 05-drum-envelope
# punch-in in the karaoke room, while playing
tap FX
tap PLAY
wait 1200
keydown 14
wait 600
shot 06-punch-stutter
keyup 14
keydown 23
wait 500
keyup 23
tap PLAY
# mute the drums from anywhere: HOME + black key 4
tap HOME
down HOME
key 8
up HOME
expect msg muted
# every help card fits its box, on each screen it is held on
expect cards 1
# a help card: SEQ held alone
down SEQ 1200
shot 07-card
up SEQ
# save to S3 with SAVE + white key 3, then load S3 from Setup's list
down SAVE
key 4
up SAVE
expect saved 2
tap SAVE
tap SEL
turn SELECT -1
shot 08-setup-list
tap SEL
expect slot 1
expect page Sing
shot 09-loaded
# the effects keys: the first of each family of four is lit (white keys 1, 5, 9, 13 = keys 0, 7, 14, 21), the
# others dark
tap FX
expect key_led 0 1
expect key_led 2 0
expect key_led 4 0
expect key_led 7 1
expect key_led 12 0
expect key_led 14 1
expect key_led 19 0
expect key_led 21 1
expect key_led 24 0
expect key_led 9 0
# a punch-in key held: lit; let go: it blinks; two held together: both blink after
keydown 9
expect key_led 9 1
keyup 9
expect key_blinks 9
keydown 11
keydown 16
keyup 11
keyup 16
expect key_blinks 11
expect key_blinks 16
expect key_led 9 0
